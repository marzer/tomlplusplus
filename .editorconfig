root = true

[*]
insert_final_newline = true
indent_style = tab
indent_size = 4
tab_width = 4
end_of_line = lf
trim_trailing_whitespace = true
charset = utf-8
max_line_length = 120

[*.{gitattributes,yaml,yml,rc,clang-format,clang-tidy,toml,py,cmake,md,markdown}]
indent_style = space

[CMakeLists.txt]
indent_style = space

[*.{hlsl,rc}]
end_of_line = crlf
